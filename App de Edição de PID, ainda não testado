    Serial.println(kd);*/
  }
  if(RoboLigado == false){
    // travar motores ou mandar um vazio
  }
}

// --> Função para editar PID
void EditPID() {
  if (SerialBT.available()) {
    char c = SerialBT.read();

    if (c == '\n') {
      processMessage(Entrada);
      Entrada = "";
    } else {
      Entrada += c;
      }
    }
}
void processMessage(String valor) {

  Serial.print("Recebido: ");
  Serial.println(valor);

  // Start Stop
  if(valor == "S"){
    RoboLigado = true;
    Serial.println("Robo Ligado!!");
    
    SerialBT.println("Robo Andando!!");
    return;
  }
  if(valor == "s"){
    RoboLigado = false;
    Serial.println("Robo Desligado!!");

    SerialBT.println("Robo Parado!!");
    return;
  }

  if (valor.startsWith("KP=")) {
    kp = valor.substring(3).toFloat();
    Serial.print("Novo Kp: ");
    Serial.println(kp);

    SerialBT.print("Novo kp = ");
    SerialBT.println(kp);
    SerialBT.println("");
  }

  if (valor.startsWith("KI=")) {
    ki = valor.substring(3).toFloat();
    Serial.print("Novo Ki: ");
    Serial.println(ki);

    SerialBT.print("Novo ki = ");
    SerialBT.println(ki);
    SerialBT.println("");
  }

  if (valor.startsWith("KD=")) {
    kd = valor.substring(3).toFloat();
    Serial.print("Novo Kd: ");
    Serial.println(kd);

    SerialBT.print("Novo kd = ");
    SerialBT.println(kd);
    SerialBT.println("");
  }
}


