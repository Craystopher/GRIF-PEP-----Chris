BluetoothSerial SerialBT;

// Variáveis do PID
float kp = 0.0;
float ki = 0.0;
float kd = 0.0;

String Entrada = "";

bool RoboLigado = false;

void setup() {
  Serial.begin(115200);
  SerialBT.begin("ESP32_PID");
  Serial.printf("Bluetooth LIGADO!");
}

void loop() {
  
  EditPID();

  // --> Start / Stop
  if(RoboLigado == true){
